<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>ja</string>
	<key>CFBundleExecutable</key>
	<string>DizunApp</string>
	<key>CFBundleIdentifier</key>
	<string>com.devdoglab.dizun</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Dizun</string>
	<key>CFBundleDisplayName</key>
	<string>DIZUN</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<!-- Regular app: the Dock icon is a drag-and-drop target for
	     compression/extraction (pinned or while running). -->
	<key>LSUIElement</key>
	<false/>
	<key>NSHighResolutionCapable</key>
	<true/>
	<!-- ZIP handling: visible in 開く/Open With. Rank Alternate — DIZUN never
	     claims the default association; switching stays a user action. -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>ZIP archive</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.zip-archive</string>
				<string>com.pkware.zip-archive</string>
			</array>
		</dict>
		<!-- Droplet claim: the Dock only accepts drops on a *non-running*
		     pinned icon for types the app declares, so compression targets
		     need the generic item type (Keka-style). Viewer/Alternate keeps
		     DIZUN out of default-handler slots for ordinary files. -->
		<dict>
			<key>CFBundleTypeName</key>
			<string>Any file or folder (compress)</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.item</string>
				<string>public.folder</string>
			</array>
		</dict>
	</array>
	<!-- Finder right-click Services. NSSendFileTypes (UTI-based) is required
	     for Finder to consider the service applicable to a file selection;
	     legacy NSSendTypes alone registers but never shows in the menu. -->
	<key>NSServices</key>
	<array>
		<dict>
			<key>NSMenuItem</key>
			<dict>
				<key>default</key>
				<string>DIZUNで圧縮</string>
			</dict>
			<key>NSMessage</key>
			<string>compressService</string>
			<key>NSPortName</key>
			<string>Dizun</string>
			<key>NSRequiredContext</key>
			<dict/>
			<key>NSSendFileTypes</key>
			<array>
				<string>public.item</string>
				<string>public.folder</string>
			</array>
		</dict>
		<dict>
			<key>NSMenuItem</key>
			<dict>
				<key>default</key>
				<string>DIZUNで解凍</string>
			</dict>
			<key>NSMessage</key>
			<string>extractService</string>
			<key>NSPortName</key>
			<string>Dizun</string>
			<key>NSRequiredContext</key>
			<dict/>
			<key>NSSendFileTypes</key>
			<array>
				<string>public.zip-archive</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
